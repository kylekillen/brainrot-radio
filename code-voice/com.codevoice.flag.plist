<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.codevoice.flag</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kylekillen/brainrot-radio/code-voice/restore-flag.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Self-heal: the flag lives in /tmp, which macOS auto-cleans after ~3 days
         of no access. RunAtLoad only fires at login, so on a long-uptime machine
         (no reboot) the flag would vanish mid-session and voice silently died
         (2026-07-03 incident: flag gone after 5 days uptime, no summaries). Re-run
         the restore every 30 min so a cleaned flag is back within the window. The
         job is a cheap file-copy; source of truth stays ~/.config/codevoice/voice-scope. -->
    <key>StartInterval</key>
    <integer>1800</integer>
</dict>
</plist>
